# Szerver
PORT=4000
NODE_ENV=development

# Cross-origin admin hozzaferes engedelyezese hitelesitett (cookie-s) kerésekhez.
# Ures ertek eseten csak azonos originrol (pl. ugyanaz a szerver szolgalja ki
# a /admin frontendet es az /api API-t) mukodik a bejelentkezes - ez az
# ajanlott alapertelmezes. Csak akkor allitsd be, ha az admin frontendet
# kulon cimen/porton futtatod, mint a backendet, pl.:
# ALLOWED_ORIGIN=https://admin.example.com
ALLOWED_ORIGIN=

# Az adatfajlok (content/data/*.enc) titkositasahoz hasznalt AES-256 kulcs.
# 64 karakteres hex string (32 byte). KOTELEZO, a szerver nelkule nem indul el.
# Generalas: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# JWT alapu authentikaciohoz hasznalt titok. KOTELEZO.
# Generalas: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# A HttpOnly session cookie alairasahoz hasznalt titok. KOTELEZO.
# Generalas: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# Opcionalis: az elso admin felhasznalo adatai. Csak akkor hasznalt, ha meg
# egyetlen felhasznalo sincs a rendszerben. Ha ures marad, a rendszer
# "admin" felhasznalonevvel es veletlen generalt jelszoval hozza letre az
# elso fiokot - a jelszo egyszer, a szerver inditasi logjaban jelenik meg.
ADMIN_USERNAME=
ADMIN_PASSWORD=
