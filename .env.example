# Szerver
PORT=4000
NODE_ENV=development

# Engedelyezett CORS origin (pl. a statikus oldalt vagy admin frontendet kiszolgalo cim).
# Fejlesztesben hasznalhato "*", elesben allitsd be a tenyleges admin frontend cimere.
ALLOWED_ORIGIN=*

# Az adatfajlok (content/data/*.enc) titkositasahoz hasznalt AES-256 kulcs.
# 64 karakteres hex string (32 byte). KOTELEZO, a szerver nelkule nem indul el.
# Generalas: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# JWT alapu authentikaciohoz hasznalt titok (a hitelesitesi fazistol kotelezo).
# Generalas: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# A HttpOnly cookie alairasahoz hasznalt titok (a hitelesitesi fazistol kotelezo).
COOKIE_SECRET=
